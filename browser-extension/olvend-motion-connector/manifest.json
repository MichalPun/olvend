{
  "manifest_version": 3,
  "name": "OLVEND · T-Mobile Motion",
  "version": "1.0.0",
  "description": "Bezpečně synchronizuje polohu vozidel z přihlášeného T-Mobile Motion do nástěnky OLVEND.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://tmobile-cz-web.moj.io/*",
    "https://tmobile-cz-api.moj.io/*",
    "https://tmobile-cz-identity.moj.io/*",
    "https://olvend.onrender.com/*",
    "https://rerjlkrhiytgscjerqgs.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tmobile-cz-web.moj.io/*"],
      "js": ["mojio-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://olvend.onrender.com/*"],
      "js": ["olvend-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OLVEND · T-Mobile Motion",
    "default_popup": "popup.html"
  }
}
